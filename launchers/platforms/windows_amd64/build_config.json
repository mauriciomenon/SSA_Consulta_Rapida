{
  "platform": "windows_amd64",
  "pyinstaller_args": {
    "onefile": false,
    "onedir": true,
    "optimize": 2,
    "strip": false,
    "upx_dir": null,
    "exclude_modules": [
      "tkinter",
      "test",
      "unittest"
    ],
    "hidden_imports": [
      "pandas._libs.tslibs.base",
      "pandas._libs.tslibs.nattype",
      "openpyxl.descriptors.serialisable"
    ]
  },
  "cli_config": {
    "console": true,
    "icon": "resources/app_icon.ico",
    "name": "SSA_CLI_v{version}_windows_amd64",
    "additional_args": [
      "--distpath=launchers/dist/windows_amd64",
      "--workpath=launchers/platforms/windows_amd64/temp",
      "--specpath=launchers/platforms/windows_amd64"
    ]
  },
  "gui_config": {
    "windowed": true,
    "icon": "resources/app_icon.ico",
    "name": "SSA_GUI_v{version}_windows_amd64",
    "additional_args": [
      "--distpath=launchers/dist/windows_amd64",
      "--workpath=launchers/platforms/windows_amd64/temp",
      "--specpath=launchers/platforms/windows_amd64"
    ]
  },
  "post_build": {
    "compress": true,
    "sign": false,
    "package": "zip"
  }
}
