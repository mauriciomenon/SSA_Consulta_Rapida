@startuml Modulos_Importacao_SSA

skinparam classAttributeIconSize 0

class "extracao.extractor" as Extractor {
    +extract_data_from_excel(): DataFrame
    +validate_excel_import_limits(): int
    +read_report(): tuple
}

class "core.import_single_file" as ImportOne {
    +import_single_file(): tuple
    +add_source_metadata_columns(): DataFrame
}

class "armazenamento.database" as Database {
    +insert_dataframe_with_smart_upsert(): bool
    +reset_database(): bool
}

class "armazenamento.database_upsert_logic" as Upsert {
    -_persist_ssa_event_records(conn, records, source_frame): int
}

class "utils.robust_importer" as RobustUtility {
    +import_excel_robust(): tuple
}

class "scripts.import_excel_file" as SingleCli
class "scripts.migracao.backfill_reprocessar" as BackfillCli
class "armazenamento.derivadas_sync" as Derivadas

ImportOne --> Extractor
ImportOne --> Database
SingleCli --> Extractor
SingleCli --> Database
BackfillCli --> Extractor
BackfillCli --> Database
Database --> Upsert

Extractor --> RobustUtility : somente read_report
Derivadas --> RobustUtility

note right of Extractor
  Eventos hierarquicos e resumo de
  identidade via DataFrame.attrs.
end note

@enduml
