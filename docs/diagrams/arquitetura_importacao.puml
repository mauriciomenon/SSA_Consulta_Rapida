@startuml Arquitetura_Importacao_SSA

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

package "Entradas" {
    [GUI / main.py] as MAIN
    [CLI arquivo unico] as SINGLE_CLI
    [CLI backfill] as BACKFILL_CLI
}

package "Orquestracao" {
    [core/app_logic.py] as ORCH
    [core/import_single_file.py] as IMPORT_ONE
}

package "Extracao canonica" {
    [extract_data_from_excel] as EXTRACT
    [Mappings estritos] as MAPPING
    [Captura hierarquica] as HIERARCHY
    [Resumo de identidade invalida] as INVALID
}

package "Persistencia" {
    [Smart upsert] as UPSERT
    database "ssa_table" as SSA
    database "ssa_event_records" as EVENTS
}

package "Caminhos especificos" {
    [utils/robust_importer.py] as ROBUST
    [Derivadas / read_report / simulacao] as ROBUST_USERS
}

MAIN --> ORCH
ORCH --> IMPORT_ONE
SINGLE_CLI --> EXTRACT
BACKFILL_CLI --> EXTRACT
IMPORT_ONE --> EXTRACT

EXTRACT --> MAPPING
EXTRACT --> HIERARCHY
EXTRACT --> INVALID
EXTRACT --> IMPORT_ONE : DataFrame + attrs
EXTRACT --> SINGLE_CLI : DataFrame + attrs
EXTRACT --> BACKFILL_CLI : DataFrame + attrs
IMPORT_ONE --> UPSERT
SINGLE_CLI --> UPSERT
BACKFILL_CLI --> UPSERT
UPSERT --> SSA : pais
UPSERT --> EVENTS : eventos

ROBUST_USERS --> ROBUST
ROBUST ..> EXTRACT : nao substitui o fluxo SSA

note right of UPSERT
  Pais e eventos usam a mesma transacao.
  Escrita SSA exige smart upsert.
end note

@enduml
