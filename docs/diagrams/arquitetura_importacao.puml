@startuml Arquitetura_Importacao_SSA

!define RECTANGLE class

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

package "Interface Layer" {
    [GUI\nPyQt6] as GUI
    [CLI\nTerminal] as CLI
    [Command Handlers] as CMD
}

package "Orchestration Layer" {
    [run_importer_logic] as ORCH
    [_import_single_file] as SINGLE
    [Cache Manager] as CACHE_MGR
    [Derivadas Sync] as DERIV
}

package "Extraction Layer" {
    [extract_data_from_excel] as EXTRACT
}

package "Processing Layer" {
    [import_excel_robust] as ROBUST
    [EnhancedAMSImporter] as ENHANCED
    
    package "Robust Features" {
        [Header Detection] as HEADER
        [Column Mapping] as MAPPING
        [SSA Normalization] as SSA_NORM
        [Date Parsing] as DATE
        [Coalescence] as COALESCE
        [Deduplication] as DEDUP
    }
}

package "Persistence Layer" {
    [insert_dataframe_optimized] as OPTIMIZED
    [insert_dataframe_standard] as STANDARD
    [Emergency Import] as EMERGENCY
    
    database "SQLite\n(WAL Mode)" as DB
}

package "Infrastructure" {
    [Caching System] as CACHE
    [Path Safety] as SAFETY
    [Logging] as LOG
    [Validation] as VALIDATE
}

' Relationships - Interface to Orchestration
GUI ..> ORCH : uses
CLI ..> ORCH : uses
CMD ..> ORCH : uses

' Orchestration to others
ORCH ..> CACHE_MGR : manages
ORCH ..> SINGLE : calls
ORCH ..> DERIV : triggers
ORCH ..> SAFETY : validates
ORCH ..> LOG : logs

' Single file flow
SINGLE ..> EXTRACT : extracts
SINGLE ..> VALIDATE : validates
SINGLE ..> OPTIMIZED : persists

' Extraction to Processing
EXTRACT ..> ROBUST : imports via

' Robust processing internals
ROBUST ..> HEADER : detects
ROBUST ..> MAPPING : maps
ROBUST ..> SSA_NORM : normalizes
ROBUST ..> DATE : parses
ROBUST ..> COALESCE : merges
ROBUST ..> DEDUP : removes duplicates

' Alternative processing
EXTRACT ..> ENHANCED : format detection

' Persistence
OPTIMIZED ..> DB : WAL mode
STANDARD ..> DB : standard
EMERGENCY ..> DB : fallback

' Infrastructure
CACHE_MGR ..> CACHE : reads/writes
SINGLE ..> CACHE_MGR : updates

@enduml
