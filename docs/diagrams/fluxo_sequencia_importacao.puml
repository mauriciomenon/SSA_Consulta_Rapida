@startuml Fluxo_Importacao_Sequencia

actor Usuario
participant "main.py / CLI" as ENTRY
participant "app_logic.py" as APP
participant "import_single_file.py" as IMPORT
participant "extractor.py" as EXTRACT
participant "smart upsert" as UPSERT
database "SQLite" as DB

Usuario -> ENTRY : solicitar importacao

alt full rescan / incremental principal
    ENTRY -> APP : run_importer_logic()
    APP -> APP : descobrir e ordenar arquivos
    loop cada arquivo
        APP -> IMPORT : import_single_file()
        IMPORT -> EXTRACT : extract_data_from_excel()
        EXTRACT -> EXTRACT : detectar header e aplicar mappings
        EXTRACT -> EXTRACT : capturar pais e continuacoes
        EXTRACT -> EXTRACT : resumir identidade invalida
        EXTRACT --> IMPORT : DataFrame (attrs: eventos/resumo)
        alt payload_removed > 0
            IMPORT --> APP : UNSAFE_INVALID_IDENTITY_PAYLOAD
            break rodada interrompida
                APP --> ENTRY : erro; sem promocao ou cache
            end
        else linhas de entrada > 0 e nenhuma linha aceita
            IMPORT --> APP : ALL_ROWS_REJECTED
            APP -> APP : marcar rejeicao para cache ao final
            APP -> APP : continuar proximo arquivo
        else identidade segura
            IMPORT -> IMPORT : validar e registrar identidade invalida
            IMPORT -> IMPORT : aplicar metadata do arquivo fisico
            IMPORT -> UPSERT : pais + eventos
            UPSERT -> DB : transacao unica
            DB --> UPSERT : resultado de persistencia
            UPSERT --> IMPORT : metricas de insert/update/eventos
        end
    end
else CLI auxiliar
    ENTRY -> EXTRACT : extract_data_from_excel()
    EXTRACT --> ENTRY : DataFrame (attrs: eventos/resumo)
    alt payload inseguro ou entrada toda rejeitada
        ENTRY --> Usuario : exit code nao zero
    else dry-run
        ENTRY --> Usuario : relatorio sem escrita
    else smart upsert ausente
        ENTRY --> Usuario : exit code nao zero
    else escrita segura
        ENTRY -> UPSERT : pais + eventos
        UPSERT -> DB : transacao unica
        UPSERT --> ENTRY : metricas obrigatorias
    end
end

ENTRY --> Usuario : resultado objetivo

@enduml
