#!/usr/bin/env bash
# Direnv bootstrap for SSA_Consulta_Rapida (works across WSL/mac/Linux shells).

if [[ -n "${DIRENV_IN_ENVRC:-}" ]]; then
  return 0
fi
export DIRENV_IN_ENVRC=1

watch_file scripts/env/direnv_common.sh
watch_file .python-version

# shellcheck disable=SC1090
source "./scripts/env/direnv_common.sh"

ssa_env::apply direnv

