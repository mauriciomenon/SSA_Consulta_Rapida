#!/usr/bin/env bash
# Multi-platform Direnv bootstrap for SSA_Consulta_Rapida
# Works on: Windows (PowerShell), Linux/macOS (bash/zsh)

# Prevent recursive sourcing
if [[ -n "${SSA_DIRENV_ENVRC_GUARD:-}" ]]; then
  return 0
fi
SSA_DIRENV_ENVRC_GUARD=1

# Watch common files
watch_file scripts/env/direnv_common.sh

# .envrc is evaluated by a bash-compatible shell, even on Windows.
# Keep PowerShell bootstrap separate from direnv sourcing.
if [[ "$OSTYPE" == msys* ]] || [[ "$OSTYPE" == cygwin* ]] || [[ "$OSTYPE" == win32* ]]; then
  export SSA_ENV_PLATFORM="windows-bash"
  # shellcheck disable=SC1090
  source "./scripts/env/direnv_common.sh"
else
  export SSA_ENV_PLATFORM="unix"
  # shellcheck disable=SC1090
  source "./scripts/env/direnv_common.sh"
fi

# Apply environment using platform-specific function
if command -v ssa_env::apply >/dev/null 2>&1; then
  ssa_env::apply direnv
elif command -v ssa_env_apply >/dev/null 2>&1; then
  ssa_env_apply direnv
else
  echo "[env] Error: No environment function found"
  return 1
fi
