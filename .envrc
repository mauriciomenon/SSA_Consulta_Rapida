#!/usr/bin/env bash
# Auto-activation (direnv) para SSA_Consulta_Rapida
# Regras: prioriza pyenv virtualenv definido em .python-version; fallback para .venv
# NOTE: line endings normalized to LF to avoid bash/direnv errors in WSL

# Proteção simples contra reentrada
if [[ -n "${DIRENV_IN_ENVRC:-}" ]]; then
  return 0
fi
export DIRENV_IN_ENVRC=1

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_SHELL=sh
  eval "$(pyenv init -)"
  eval "$(pyenv virtualenv-init -)"
fi

if [[ -f .python-version ]] && command -v pyenv >/dev/null 2>&1; then
  venv_name=$(tr -d '\r\n' < .python-version)
  if pyenv virtualenvs --bare | grep -qx "$venv_name"; then
    if [[ -z "${VIRTUAL_ENV:-}" || "${VIRTUAL_ENV##*/}" != "$venv_name" ]]; then
      pyenv activate "$venv_name" >/dev/null 2>&1 || true
    fi
  fi
fi

# Fallback .venv (somente se nada ativo)
if [[ -z "${VIRTUAL_ENV:-}" && -d .venv ]]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi

# Variáveis de ambiente padrão
export PYTHONUTF8=1
export PYTHONDONTWRITEBYTECODE=1

# Ajuste de PATH para scripts utilitários
export PATH="$(pwd)/scripts:$(pwd)/scripts_manutencao:$PATH"

if [[ -n "${VIRTUAL_ENV:-}" ]]; then
  echo "[direnv] Ambiente ativo: $(python -V 2>/dev/null | awk '{print $2}') ($(basename "$VIRTUAL_ENV"))"
else
  echo "[direnv] Nenhum ambiente virtual ativo (pyenv/.venv)"
fi

# Instrução curta
echo "[direnv] Use 'direnv allow' após alterações neste arquivo."
