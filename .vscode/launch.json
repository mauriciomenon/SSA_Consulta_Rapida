{
    "version": "0.2.0",
    "configurations": [
        

        {
            "name": "SSA – CLI (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}" }
        },
        {
            "name": "SSA – GUI (launcher)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launchers/gui_launcher.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}",
            "windows": {
                "program": "${workspaceFolder}/launchers/gui_launcher.pyw",
                "console": "internalConsole"
            },
            "linux": {
                "program": "${workspaceFolder}/launchers/gui_launcher.py"
            },
            "osx": {
                "program": "${workspaceFolder}/launchers/gui_launcher.py"
            }
        }
    ]
}
