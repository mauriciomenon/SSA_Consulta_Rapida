[flake8]
max-line-length = 100
extend-ignore = E203,W503
# Selecionar apenas erros e falhas críticas por padrão; avisos de complexidade opcionais
# Pode-se habilitar futuramente: C90, CCR001
show-source = True
statistics = True
count = True
# Excluir diretórios de build, caches e dados gerados
exclude = .git,__pycache__,build,dist,venv,.venv,.mypy_cache,.ruff_cache,logs,reports
